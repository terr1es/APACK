# Normalise line endings on commit, and keep the shell script runnable on checkout:
# a `build.sh` that arrives with CRLF fails with "bad interpreter" on the first run.
* text=auto
*.sh text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary.
*.exe binary
*.dll binary
