//  selfhost.ax -- APACK, written in Axiom.
//
//  Packages a program into a directory that runs on a machine without the toolchain, using
//  only what the language provides: the compiler for the dependency list, `copyFile` for
//  the files, and the standard library for everything else.
//
//  Why this exists. A packager is a tool, and a language that cannot build its own tools is
//  a language with a ceiling. This is that claim made testable: if the program below
//  produces a bundle that runs, the language is sufficient for the work -- not because the
//  code is small, but because nothing in it needed a feature that was not already there.
//
//  What it does not do:
//
//    * single-file output. That mode appends bytes to the executable and writes an
//      eight-byte little-endian footer. A `string` can carry those bytes, but there is no
//      way to assemble one byte at a time yet, so the mode stays with the native packer.
//    * version resources and icons. Those are PE structures edited through the Win32
//      resource API; `Resources.cpp` is where that lives.
//    * the checksum. `sha256.ax` could do it; it is left out so that this file stays a
//      demonstration of packaging rather than of hashing.
//
//  The dependency list is the part that matters. It comes from `acvm deps`, which runs the
//  same import walk the compiler uses -- so this packer and the native one cannot disagree
//  about what a program needs. Re-deriving it here by scanning sources would be the second
//  implementation that both were designed to avoid.

function import (return:(io));
function import (return:(os));
function import (return:(str));
function import (return:(cli));

/// Everything after the last separator, or "." when there is none.
function dirName(string path):string {
    string text = replaceAll(path, "\\", "/");
    int cut = -1;
    int at = 0;
    while (at < text.length) {
        int found = indexOf(text[at .. text.length], "/");
        if (found < 0) { break; }
        cut = at + found;
        at = cut + 1;
    }
    if (cut < 0) { return "."; }
    return text[0 .. cut];
    eof: pass;
}

/// The last component of a path, with any extension removed.
function stemOf(string path):string {
    string text = replaceAll(path, "\\", "/");
    string name = text;
    int cut = -1;
    int at = 0;
    while (at < text.length) {
        int found = indexOf(text[at .. text.length], "/");
        if (found < 0) { break; }
        cut = at + found;
        at = cut + 1;
    }
    if (cut >= 0) { name = text[cut + 1 .. text.length]; }

    int dot = -1;
    for (int i = 0; i < name.length; i++) {
        if (strByteAt(name, i) == 46) { dot = i; }   // '.'
    }
    if (dot <= 0) { return name; }
    return name[0 .. dot];
    eof: pass;
}

/// Runs a command and returns its standard output.
///
/// `runCaptureInto` reports the exit code through an array, and returns the byte count
/// written. A non-zero exit code is not visible in the text, so it is returned separately --
/// a packer that ignored it would copy files after a failed compile and call the result
/// success.
function runCapture(string command, ptr int exitCode):string {
    int capacity = 65536;
    ptr char buffer = alloc(capacity * 2) as ptr char;
    int written = runCaptureInto(command, buffer, capacity, exitCode, 1);
    if (written <= 0) { return ""; }
    return makeString(buffer, written);
    eof: pass;
}

/// Splits `line` at its first tab. The part before it is returned; `rest` receives the rest.
///
/// Compared by byte value rather than against a tab literal: the byte is unambiguous, and
/// a line that arrives with no tab at all has to come back whole rather than empty.
function splitTab(string line, ptr string rest):string {
    for (int i = 0; i < line.length; i++) {
        if (strByteAt(line, i) == 9) {
            @rest = substring(line, i + 1, line.length);
            return substring(line, 0, i);
        }
    }
    @rest = "";
    return line;
    eof: pass;
}

/// Creates `path` and every missing parent, like `mkdir -p`.
///
/// `makeDir` makes one level and fails silently when the parent is absent, which turns a
/// typo in `-o` into "cannot open ... for writing" several steps later. The native packer
/// uses `create_directories`; this is the same promise.
function makePath(string path):void {
    string text = replaceAll(path, "\\", "/");
    for (int i = 1; i < text.length; i++) {
        if (strByteAt(text, i) != 47) { continue; }   // '/'
        string prefix = text[0 .. i];
        // "C:" is a drive, not a directory: creating it is at best a no-op and at worst
        // an error that hides the real one.
        if (prefix.length <= 2 && strByteAt(prefix, 1) == 58) { continue; }
        if (!isDirectory(prefix)) { makeDir(prefix); }
    }
    if (!isDirectory(text)) { makeDir(text); }
    eof: pass;
}

/// Quotes a path for the shell, but only when it needs it.
///
/// `runCaptureInto` is `_popen`, which hands the command to `cmd /c` wrapped in another
/// pair of quotes. A command that already begins with a quote therefore reaches cmd with
/// two, its parser strips the wrong pair, and the result is
/// "the filename, directory name, or volume label syntax is incorrect" -- an error that
/// names nothing and points at the wrong place. A path without spaces needs no quotes, and
/// leaving it bare keeps the first token unambiguous.
function quoted(string path):string {
    if (indexOf(path, " ") < 0) { return path; }
    return "\"" + path + "\"";
    eof: pass;
}

/// Removes what a failed pack wrote.
///
/// A bundle is several files, and a failure partway through leaves some of them behind. That
/// is worse than writing nothing: a directory holding `MyApp.exe` and no program looks
/// finished, and the person who receives it reports "it opens and prints some usage text"
/// rather than "the pack failed".
///
/// Only the files this run created are named, so a directory that already held something is
/// not emptied.
function cleanup(string outputDir, string appName, string libraries):void {
    removeFile(outputDir + "/" + appName + ".exe");
    removeFile(outputDir + "/" + appName + ".acvm");
    SplitList parts = makeSplit(libraries, "\n");
    for (int i = 0; i < splitCount(#parts); i++) {
        string name = splitAt(#parts, i);
        if (name.length > 0) { removeFile(outputDir + "/" + name + ".dll"); }
    }
    splitFree(#parts);
    eof: pass;
}

/// Stops with an exit code.
///
/// Returning normally after a failure reports success: the shell sees 0, and a build script
/// that asked for a bundle moves on to the next step as though it had one. The codes follow
/// the native packer's, so a script written against one works with the other.
function stop(int code):void {
    exitProcess(code);
    eof: pass;
}

function main():void {
    Doc d = docNew(0);
    ptr CliArgs args = cliParseArgvWith(#d, "o:name:runtime:");

    if (cliFailed(args)) {
        print("apack: "); print(cliErrorText(args)); print("\n");
        docFree(#d);
        stop(2);
    }
    if (cliPositionalCount(args) < 1) {
        print("usage: apack <file.ax> -o <dir> [--name <name>] [--runtime <dir>]\n");
        docFree(#d);
        stop(2);
    }

    string source = cliPositionalAt(args, 0);
    string outputDir = cliValue(args, "o", "");
    if (outputDir.length == 0) {
        print("apack: -o is required: a bundle needs somewhere to go\n");
        docFree(#d);
        stop(2);
    }
    string appName = cliValue(args, "name", stemOf(source));

    // The runtime is where the compiler is: a program that can run this one can tell us
    // where its own executable lives, and the standard library sits beside it.
    int pathCapacity = 4096;
    ptr char pathBuffer = alloc(pathCapacity * 2) as ptr char;
    int pathLength = exePathInto(pathBuffer, pathCapacity);
    string selfPath = pathLength > 0 ? makeString(pathBuffer, pathLength) : "";

    // The compiler is not necessarily this program. Once APACK has been packaged by itself,
    // its own executable is a launcher, and asking that launcher to compile runs this
    // program again with "build" as its first argument -- which is exactly what happened
    // the first time the round trip was tried. The compiler is looked for in the runtime
    // directory instead, where the standard library lives too.
    string runtimeDir = cliValue(args, "runtime", dirName(selfPath));
    string compiler = runtimeDir + "/acvm.exe";
    if (!fileExists(compiler)) { compiler = runtimeDir + "/acvm"; }
    if (!fileExists(compiler)) {
        print("apack: cannot find acvm in "); print(runtimeDir); print("\n");
        print("       pass --runtime <dir> to point at the toolchain\n");
        docFree(#d);
        stop(2);
    }

    if (!fileExists(source)) {
        print("apack: no such file: "); print(source); print("\n");
        docFree(#d);
        stop(2);
    }

    makePath(outputDir);
    string payload = outputDir + "/" + appName + ".acvm";

    // ── compile ─────────────────────────────────────────────────────────────
    ptr int code = alloc(4) as ptr int;
    code[0] = 0;
    string buildOutput = runCapture(quoted(compiler) + " build " + quoted(source) + " -o " +
                                    quoted(payload), code);
    if (code[0] != 0) {
        print("apack: compile failed\n");
        print(buildOutput);
        removeFile(payload);   // a half-written bundle looks finished
        docFree(#d);
        stop(1);
    }

    // ── dependencies ────────────────────────────────────────────────────────
    //
    // One library name per line, from the compiler's own import walk. The same list the
    // native packer gets by calling into the driver directly.
    code[0] = 0;
    string libraries = runCapture(quoted(compiler) + " deps " + quoted(source), code);
    if (code[0] != 0) {
        print("apack: cannot read the dependency list\n");
        removeFile(payload);
        docFree(#d);
        stop(1);
    }

    // ── verify the payload ──────────────────────────────────────────────────
    //
    // Read back through the compiler's own reader. This is the half of "run it once" that
    // does not run anything: a truncated write, a container the runtime will refuse, and a
    // file that is not what was just compiled all look identical until someone opens it.
    code[0] = 0;
    runCapture(quoted(compiler) + " verify " + quoted(payload), code);
    if (code[0] != 0) {
        print("apack: the payload does not read back; the bundle is not usable\n");
        removeFile(payload);
        docFree(#d);
        stop(5);
    }

    // ── copy ────────────────────────────────────────────────────────────────
    if (copyFile(runtimeDir + "/acvm.exe", outputDir + "/" + appName + ".exe") != 0) {
        print("apack: cannot copy the runtime from "); print(runtimeDir); print("\n");
        removeFile(payload);
        docFree(#d);
        stop(4);
    }

    SplitList lines = makeSplit(libraries, "\n");
    int copied = 0;
    string copiedNames = "";   // one per line, for cleanup if a later step fails
    for (int i = 0; i < splitCount(#lines); i++) {
        // `_popen` goes through cmd, so the output is CRLF: splitting on "\n" leaves a
        // trailing carriage return on every line but the last, and a file name with an
        // invisible character at the end is a file that does not exist.
        string entry = trimSuffix(splitAt(#lines, i), "\r");
        if (entry.length == 0) { continue; }

        // `name<TAB>path`, where the path is the file that declared the library.
        string declaredPath = "";
        string name = splitTab(entry, #declaredPath);

        // A module in the project keeps its shared object beside its own `.axd`; a standard
        // module keeps its beside the compiler. Trying the declaring file's directory first
        // is what makes a project-local module packable at all -- knowing only the name
        // would send the search to the wrong directory and report a missing library that is
        // sitting right next to the source.
        string from = "";
        if (declaredPath.length > 0) {
            string beside = dirName(declaredPath) + "/" + name + ".dll";
            if (fileExists(beside)) { from = beside; }
        }
        if (from.length == 0) {
            string standard = runtimeDir + "/" + name + ".dll";
            if (fileExists(standard)) { from = standard; }
        }
        if (from.length == 0) {
            print("apack: required library not found: "); print(name); print("\n");
            print("       looked beside "); print(declaredPath); print("\n");
            print("       and beside the runtime ("); print(runtimeDir); print(")\n");
            splitFree(#lines);
            cleanup(outputDir, appName, copiedNames);
            docFree(#d);
            stop(3);
        }

        string to = outputDir + "/" + name + ".dll";
        if (copyFile(from, to) != 0) {
            print("apack: cannot copy "); print(from); print("\n");
            splitFree(#lines);
            cleanup(outputDir, appName, copiedNames);
            docFree(#d);
            stop(4);
        }

        // A copy that succeeded can still be useless. A library whose own dependencies are
        // missing loads on this machine and fails on the recipient's, and the copy reported
        // success in both cases -- so the question asked here is not "did it copy" but "does
        // it load from where it now sits".
        if (!libraryLoads(to)) {
            print("apack: "); print(name); print(".dll does not load from the bundle\n");
            splitFree(#lines);
            cleanup(outputDir, appName, copiedNames);
            docFree(#d);
            stop(5);
        }
        copied = copied + 1;
        copiedNames = copiedNames + name + "\n";
    }
    splitFree(#lines);

    print("packed "); print(source); print(" -> "); print(outputDir); print("/\n");
    print("  "); print(appName); print(".exe\n");
    print("  "); print(appName); print(".acvm\n");
    if (copied > 0) {
        print("  "); print(itoa(copied, 10)); print(" librar");
        print(copied == 1 ? "y" : "ies"); print("\n");
    }
    docFree(#d);
    eof: pass;
}
